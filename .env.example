# Ersatz environment template. Copy to .env and fill in. .env is git-ignored.

# Distributor APIs: lookup, parametric search, lifecycle, stock
# Digi-Key: create an application at https://developer.digikey.com (Product Information API v4)
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
# true to use sandbox-api.digikey.com while production access is pending. Default: false
DIGIKEY_USE_SANDBOX=
# Mouser: request a Search API key at https://www.mouser.com/api-hub/
MOUSER_API_KEY=
# Nexar (Octopart): optional in v0.1, create an application at https://nexar.com
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=

# Datasheet extraction
# Anthropic API key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# Extraction provider and model. Defaults when empty: anthropic and claude-opus-5-5
ERSATZ_LLM_PROVIDER=
ERSATZ_LLM_MODEL=

# Ersatz-Bench subjects: only needed to run the benchmark harness
# OpenAI: https://platform.openai.com
OPENAI_API_KEY=
# Google Gemini: https://aistudio.google.com
GEMINI_API_KEY=
# Hosted open-weight model: https://openrouter.ai
OPENROUTER_API_KEY=

# API cache: Postgres connection string from the Vercel marketplace (https://vercel.com/marketplace)
DATABASE_URL=

# Local paths
# Datasheet and provider cache directory. Default when empty: cache/
ERSATZ_CACHE_DIR=
